{
  "name": "syncpoint-core",
  "version": "0.1.0",
  "description": "SyncPoint protocol core — types, state machine, Zod schemas",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MIK-HEAL/SyncPoint"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./foundation": {
      "source": "./src/foundation-api.ts",
      "types": "./dist/foundation-api.d.ts",
      "import": "./dist/foundation-api.js"
    },
    "./context": {
      "source": "./src/context-api.ts",
      "types": "./dist/context-api.d.ts",
      "import": "./dist/context-api.js"
    },
    "./runtime": {
      "source": "./src/runtime-api.ts",
      "types": "./dist/runtime-api.d.ts",
      "import": "./dist/runtime-api.js"
    },
    "./protocol": {
      "source": "./src/protocol-api.ts",
      "types": "./dist/protocol-api.d.ts",
      "import": "./dist/protocol-api.js"
    },
    "./negotiation": {
      "source": "./src/negotiation-api.ts",
      "types": "./dist/negotiation-api.d.ts",
      "import": "./dist/negotiation-api.js"
    },
    "./kernel": {
      "source": "./src/_exports/kernel.ts",
      "types": "./dist/_exports/kernel.d.ts",
      "import": "./dist/_exports/kernel.js"
    },
    "./governance": {
      "source": "./src/_exports/governance.ts",
      "types": "./dist/_exports/governance.d.ts",
      "import": "./dist/_exports/governance.js"
    },
    "./context-layer": {
      "source": "./src/_exports/context.ts",
      "types": "./dist/_exports/context.d.ts",
      "import": "./dist/_exports/context.js"
    },
    "./adapters-layer": {
      "source": "./src/_exports/adapters.ts",
      "types": "./dist/_exports/adapters.d.ts",
      "import": "./dist/_exports/adapters.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "syncpoint-kernel": "workspace:*",
    "syncpoint-governance": "workspace:*",
    "syncpoint-context": "workspace:*",
    "syncpoint-adapters": "workspace:*",
    "yaml": "^2.4.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
