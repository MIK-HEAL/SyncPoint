{
  "name": "syncpoint-cli",
  "version": "0.1.0",
  "description": "SyncPoint CLI — command-line interface for synchronization gates, claims, transactions, and patches",
  "type": "module",
  "bin": {
    "syncpoint": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
