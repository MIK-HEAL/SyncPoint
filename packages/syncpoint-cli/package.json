{
  "name": "syncpoint-cli",
  "version": "0.1.0",
  "description": "SyncPoint CLI — stop unsafe AI continuation before it breaks your project",
  "type": "module",
  "bin": {
    "syncpoint": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "syncpoint",
    "ai-agents",
    "synchronization",
    "collaboration",
    "file-claims",
    "sync-gates",
    "checkpoint",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MIK-HEAL/SyncPoint"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "syncpoint-core": "workspace:*",
    "syncpoint-server": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0"
  }
}
