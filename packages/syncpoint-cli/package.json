  },
  "dependencies": {
    "syncpoint-core": "workspace:*",
    "syncpoint-server": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0"
  }
}
