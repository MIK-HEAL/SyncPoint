{
  "name": "syncpoint-server",
  "version": "0.1.0",
  "description": "SyncPoint local server — tRPC + Drizzle + SQLite + SSE",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MIK-HEAL/SyncPoint"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./repositories": {
      "source": "./src/repositories.ts",
      "types": "./dist/repositories.d.ts",
      "import": "./dist/repositories.js"
    },
    "./application": {
      "source": "./src/application/index.ts",
      "types": "./dist/application/index.d.ts",
      "import": "./dist/application/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "syncpoint-core": "workspace:*",
    "syncpoint-plugin-code": "workspace:*",
    "syncpoint-plugin-generic-agent": "workspace:*",
    "@trpc/server": "^11.0.0",
    "@trpc/client": "^11.0.0",
    "drizzle-orm": "^0.36.0",
    "better-sqlite3": "^11.0.0",
    "nanoid": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "drizzle-kit": "^0.28.0"
  }
}
