{
  "name": "syncpoint-vscode",
  "displayName": "SyncPoint",
  "description": "Sync View for editor AI synchronization: sessions, claims, blockers, patches, and wake obligations",
  "version": "0.1.0",
  "publisher": "syncpoint",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.syncpoint",
    "workspaceContains:.syncpoint/syncpoint.db"
  ],
  "type": "module",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "syncpoint",
          "title": "SyncPoint",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "syncpoint": [
        {
          "id": "syncpoint-sync-view",
          "name": "Sync View",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "SyncPoint",
      "properties": {
        "syncpoint.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "SyncPoint server URL"
        },
        "syncpoint.agentId": {
          "type": "string",
          "default": "",
          "description": "Agent ID used by the VS Code File Audit Guard"
        },
        "syncpoint.taskId": {
          "type": "string",
          "default": "",
          "description": "Task ID used by the VS Code File Audit Guard"
        },
        "syncpoint.sessionId": {
          "type": "string",
          "default": "",
          "description": "Optional session ID used by the VS Code File Audit Guard"
        },
        "syncpoint.fileGuard.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the File Audit Guard: best-effort pre-save warnings and post-save auditing, not a hard filesystem lock or save blocker"
        },
        "syncpoint.fileGuard.auditOnly": {
          "type": "boolean",
          "default": false,
          "description": "Log file audit events from VS Code saves without creating or updating SyncGates"
        },
        "syncpoint.fileGuard.mode": {
          "type": "string",
          "enum": [
            "audit",
            "editor-strict",
            "proxy-strict"
          ],
          "default": "audit",
          "description": "File guard mode. editor-strict enables syncpoint: guarded documents that save through write permits"
        }
      }
    },
    "commands": [
      {
        "command": "syncpoint.startServer",
        "title": "SyncPoint: Start Server"
      },
      {
        "command": "syncpoint.registerAgent",
        "title": "SyncPoint: Add New Member"
      },
      {
        "command": "syncpoint.createTask",
        "title": "SyncPoint: Create Task"
      },
      {
        "command": "syncpoint.refreshStatus",
        "title": "SyncPoint: Refresh Status"
      },
      {
        "command": "syncpoint.resumePrompt",
        "title": "SyncPoint: Resume Prompt"
      },
      {
        "command": "syncpoint.copyResumePrompt",
        "title": "SyncPoint: Copy Resume Prompt"
      },
      {
        "command": "syncpoint.writeRulesFile",
        "title": "SyncPoint: Write Rules File"
      },
      {
        "command": "syncpoint.openGuardedFile",
        "title": "SyncPoint: Open Guarded File"
      },
      {
        "command": "syncpoint.guardedSave",
        "title": "SyncPoint: Guarded Save"
      },
      {
        "command": "syncpoint.gateApprove",
        "title": "SyncPoint: Gate — Approve"
      },
      {
        "command": "syncpoint.gateReject",
        "title": "SyncPoint: Gate — Reject"
      },
      {
        "command": "syncpoint.gateAbstain",
        "title": "SyncPoint: Gate — Abstain"
      },
      {
        "command": "syncpoint.gateEscalate",
        "title": "SyncPoint: Gate — Escalate"
      },
      {
        "command": "syncpoint.gateResolve",
        "title": "SyncPoint: Gate — Resolve"
      },
      {
        "command": "syncpoint.gateCancel",
        "title": "SyncPoint: Gate — Cancel"
      },
      {
        "command": "syncpoint.openDecisionPanel",
        "title": "SyncPoint: Open Decision Panel"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "syncpoint.registerAgent",
          "when": "view == syncpoint-sync-view",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@trpc/client": "^11.0.0",
    "syncpoint-core": "workspace:*",
    "syncpoint-kernel": "workspace:*",
    "syncpoint-context": "workspace:*",
    "syncpoint-adapters": "workspace:*",
    "syncpoint-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  }
}
