{
  "name": "syncpoint-loop-runner",
  "version": "0.1.0",
  "description": "SyncPoint Loop Runner — autonomous orchestrator that runs Claude Code agents in parallel",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "syncpoint-loop-runner": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "syncpoint",
    "ai-agents",
    "autonomous",
    "orchestrator",
    "claude-code",
    "loop-runner"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MIK-HEAL/SyncPoint"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "syncpoint-sdk": "workspace:*",
    "commander": "^12.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0"
  }
}
