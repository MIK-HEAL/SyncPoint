{
  "name": "syncpoint-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "SyncPoint - Synchronization protocol layer for editor AI agents",
  "scripts": {
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter syncpoint-server dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter syncpoint-core test",
    "test:server": "pnpm --filter syncpoint-server test",
    "test:sdk": "pnpm --filter syncpoint-sdk test",
    "test:cli": "pnpm --filter syncpoint-cli test",
    "release:npm": "node scripts/release-npm.mjs",
    "publish:npm": "node scripts/publish-npm.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
